# ============================================================================
# ~/.ssh/config (symlinked from dotfiles/.ssh/config)
# Host-specific entries go in ~/.ssh/config.local (untracked; missing is OK).
# ============================================================================
Include config.local

Host *
    # keep long-running sessions alive
    ServerAliveInterval 60
    ServerAliveCountMax 5
    TCPKeepAlive yes

    # multiplex connections — faster reconnects, fewer auth prompts
    ControlMaster auto
    ControlPath ~/.ssh/sockets/%r@%h-%p
    ControlPersist 600

    # load keys into the agent / macOS keychain automatically
    AddKeysToAgent yes
    UseKeychain yes
